# =======================================================
# .env.example - Configurações de ambiente
# COMO USAR: Copie este arquivo para .env e preencha os valores
# Comando: cp .env.example .env
# =======================================================

# Chave secreta do Django - TROQUE EM PRODUÇÃO!
# Gere uma nova em: https://djecrety.ir/
SECRET_KEY=django-insecure-trocar-esta-chave-em-producao-123456789

# Modo debug - True para desenvolvimento, False para produção
DEBUG=True

# Chave da API OpenAI - Obtenha em: https://platform.openai.com/api-keys
# Se não tiver, o sistema usa análise local automática
OPENAI_API_KEY=sk-sua-chave-aqui
